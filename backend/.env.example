RDL_SERVICE_NAME=Retail Decision Lab API
# JSON array of exact browser origins; no wildcard.
RDL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]

# Backend-only secrets. Copy the URL from Supabase > Connect. Never use VITE_.
# Percent-encode special characters in the password.
DATABASE_URL=
# Required when DATABASE_URL uses transaction pooling; use a direct or session URL.
MIGRATION_DATABASE_URL=

# Backend-only AI credentials. Existing features work when this is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RDL_ASSISTANT_REQUEST_TIMEOUT_SECONDS=15
RDL_ASSISTANT_TOTAL_TIMEOUT_SECONDS=45

# session: persistent backend on IPv4; direct: IPv6; transaction: transient hosts.
RDL_DB_POOL_MODE=session
RDL_DB_SSLMODE=require
# For certificate validation use verify-full and a downloaded Supabase CA file:
# RDL_DB_SSL_ROOT_CERT=/path/to/prod-supabase.cer
RDL_DB_POOL_SIZE=5
RDL_DB_MAX_OVERFLOW=0
RDL_DB_POOL_TIMEOUT=3
RDL_DB_CONNECT_TIMEOUT=3
RDL_DB_STATEMENT_TIMEOUT_MS=5000

# Integration tests NEVER use DATABASE_URL. Only an explicit LOCAL test URL is accepted.
# Set in your terminal, not here: TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/rdl_test_admin?sslmode=disable
