    "/api/dashboard/summary": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Summary",
        "description": "Phase 02 compatibility contract: completed merchandise sales under its original tax-exclusive convention, without refund or customer shipping adjustments. Use /api/finance/summary for VAT-aware financial reporting and completeness indicators.",
        "operationId": "summary_api_dashboard_summary_get",
        "deprecated": true,
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
