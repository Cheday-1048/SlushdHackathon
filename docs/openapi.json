  "components": {
    "schemas": {
      "AnalyticsDashboard": {
        "properties": {
          "summary": {
            "$ref": "#/components/schemas/FinanceSummary"
          },
          "store_timezone": {
            "type": "string",
            "title": "Store Timezone"
          },
          "as_of_date": {
            "type": "string",
            "format": "date",
            "title": "As Of Date"
          },
          "selected_preset": {
            "type": "string",
            "enum": [
              "demo",
              "custom",
              "last_7_days",
              "last_30_days",
              "last_90_days"
            ],
            "title": "Selected Preset"
          },
          "daily": {
            "items": {
              "$ref": "#/components/schemas/DailyAnalytics"
            },
            "type": "array",
            "title": "Daily"
          },
          "products": {
            "items": {
              "$ref": "#/components/schemas/ProductAnalytics"
            },
            "type": "array",
            "title": "Products"
          },
          "expenses": {
            "items": {
              "$ref": "#/components/schemas/ExpenseAnalytics"
            },
            "type": "array",
            "title": "Expenses"
          },
          "unallocated_customer_shipping_revenue": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unallocated Customer Shipping Revenue"
          },
          "product_warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Product Warnings"
          }
        },
        "type": "object",
        "required": [
          "summary",
          "store_timezone",
          "as_of_date",
          "selected_preset",
          "daily",
          "products",
          "expenses",
          "unallocated_customer_shipping_revenue",
          "product_warnings"
        ],
        "title": "AnalyticsDashboard"
      },
      "DailyAnalytics": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "revenue": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revenue"
          },
          "order_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Order Count"
          },
          "visitors": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Visitors"
          },
          "conversion_rate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversion Rate"
          },
          "operating_expenses": {
            "type": "string",
            "title": "Operating Expenses"
          },
          "advertising_expenditure": {
            "type": "string",
            "title": "Advertising Expenditure"
          },
          "total_expenses": {
            "type": "string",
            "title": "Total Expenses"
          },
          "gross_profit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gross Profit"
          },
          "operating_profit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Operating Profit"
          },
          "data_completeness": {
            "$ref": "#/components/schemas/DataCompleteness"
          }
        },
        "type": "object",
        "required": [
          "date",
          "revenue",
          "order_count",
          "visitors",
          "conversion_rate",
          "operating_expenses",
          "advertising_expenditure",
          "total_expenses",
          "gross_profit",
          "operating_profit",
          "data_completeness"
        ],
        "title": "DailyAnalytics"
      },
      "DashboardSummary": {
        "properties": {
          "revenue": {
            "type": "string",
            "title": "Revenue"
          },
          "total_orders": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Orders"
          },
          "total_visitors": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Visitors"
          },
          "conversion_rate": {
            "type": "string",
            "title": "Conversion Rate",
            "description": "Percentage of visitors who placed an order, rounded to two decimals"
          },
          "total_expenses": {
            "type": "string",
            "title": "Total Expenses"
          },
          "operating_expenses": {
            "type": "string",
            "title": "Operating Expenses"
          },
          "advertising_expenditure": {
            "type": "string",
            "title": "Advertising Expenditure"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency"
          },
          "reporting_period": {
            "$ref": "#/components/schemas/ReportingPeriod"
          },
          "data_source": {
            "$ref": "#/components/schemas/DataSource"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revenue",
          "total_orders",
          "total_visitors",
          "conversion_rate",
          "total_expenses",
          "operating_expenses",
          "advertising_expenditure",
          "currency",
          "reporting_period",
          "data_source"
        ],
        "title": "DashboardSummary"
      },
      "DataCompleteness": {
        "properties": {
          "is_complete": {
            "type": "boolean",
            "title": "Is Complete"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "missing_vat_lines": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Missing Vat Lines"
          },
          "missing_refund_orders": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Missing Refund Orders"
          },
          "missing_shipping_orders": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Missing Shipping Orders"
          },
          "missing_restock_refunds": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Missing Restock Refunds"
          },
          "missing_order_items": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Missing Order Items"
          },
          "traffic_days": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Traffic Days"
          },
          "expected_traffic_days": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Traffic Days"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "is_complete",
          "warnings",
          "missing_vat_lines",
          "missing_refund_orders",
          "missing_shipping_orders",
          "missing_restock_refunds",
          "missing_order_items",
          "traffic_days",
          "expected_traffic_days"
        ],
        "title": "DataCompleteness"
      },
      "DataSource": {
        "properties": {
          "type": {
            "type": "string",
            "const": "database_demo",
            "title": "Type",
            "default": "database_demo"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "title": "Description"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "description"
        ],
        "title": "DataSource"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "ExpenseAnalytics": {
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "employee_costs",
              "rent",
              "shipping",
              "platform_fees",
              "other_operating",
              "advertising"
            ],
            "title": "Category"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          }
        },
        "type": "object",
        "required": [
          "category",
          "label",
          "amount"
        ],
        "title": "ExpenseAnalytics"
      },
      "ExpenseList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ExpenseRead"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "store_id": {
            "type": "string",
            "format": "uuid",
            "title": "Store Id"
          },
          "data_source": {
            "$ref": "#/components/schemas/DataSource"
          },
          "reporting_period": {
            "$ref": "#/components/schemas/ReportingPeriod"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset",
          "store_id",
          "data_source",
          "reporting_period"
        ],
        "title": "ExpenseList"
      },
      "ExpenseRead": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "store_id": {
            "type": "string",
            "format": "uuid",
            "title": "Store Id"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          },
          "expense_date": {
            "type": "string",
            "format": "date",
            "title": "Expense Date"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "included_in_operating_expenses": {
            "type": "boolean",
            "title": "Included In Operating Expenses",
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "store_id",
          "category",
          "amount",
          "expense_date",
          "description",
          "created_at",
          "included_in_operating_expenses"
        ],
        "title": "ExpenseRead"
      },
